{
  "name": "zvuki-lesa-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "seed": "tsx --env-file=.env src/db/seed.ts",
    "seed:drafts": "tsx --env-file=.env src/scripts/seedDrafts.ts",
    "sync:reviews": "tsx --env-file=.env src/scripts/syncYandexReviews.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "multer": "^2.2.0",
    "postgres": "^3.4.5",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.30.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^2.1.8"
  }
}
