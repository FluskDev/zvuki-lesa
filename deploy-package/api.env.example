# ─── Сервер ───────────────────────────────────────────────────────────────
# Порт API (по умолчанию 3001)
PORT=3001

# ─── База данных (Postgres) ───────────────────────────────────────────────
# Боевой DATABASE_URL — PG 18.x, хост сервера.
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:PASSWORD@192.168.1.103:5432/ZvukiLesa

# Тестовая БД (используется vitest). ОБЯЗАТЕЛЬНО отдельная база —
# beforeEach чистит таблицы, prod-данные уничтожит.
TEST_DATABASE_URL=postgres://postgres:PASSWORD@192.168.1.103:5432/zvuki-lesa-test

# ─── Админка ─────────────────────────────────────────────────────────────
# Пароль для входа в /admin/login (отдельный пользователь, не гость)
ADMIN_PASSWORD=change-me-strong-password

# Секрет подписи Bearer-токена (HMAC-SHA256).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-string-base64

# ─── MAX-бот (https://dev.max.ru) ────────────────────────────────────────
# Токен бота для уведомлений владельцу и жене о новых бронях.
# Создать бота: https://dev.max.ru → BotFather → получить токен.
MAX_BOT_TOKEN=

# Кодовое слово для команды /join (подписка на уведомления).
# Владелец и жена пишут боту: /start, затем /join <код>.
MAX_JOIN_CODE=1501

# ─── Telegram-уведомления (через Cloudflare Worker-релей) ─────────────────
# api.telegram.org недоступен с российских IP, поэтому шлём через воркер.
# Нужен НОВЫЙ бот «Звуков леса» (не бот Вики) — @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# Chat ID получателей через запятую. Узнать свой id:
# @userinfobot в Telegram, либо любой ваш бот — посмотреть sender id.
TELEGRAM_CHAT_IDS=

# URL Cloudflare Worker-релея (стандартный, lemonadka-tg)
TELEGRAM_RELAY_URL=https://lemonadka-tg.ivladok01.workers.dev

# Shared secret между API и релеем — должен совпадать с секретом в воркере.
TELEGRAM_RELAY_SECRET=change-me-shared-with-worker

# ─── Яндекс.Карты: парсинг отзывов ───────────────────────────────────────
# Ссылка на бизнес-страницу, например https://yandex.ru/maps/-/CTRYvF3q
YANDEX_MAPS_URL=

# Если 'true', новые отзывы сразу публикуются.
# По умолчанию false — попадают в /admin/reviews как черновики,
# владелец публикует вручную.
YANDEX_REVIEWS_AUTO_PUBLISH=false
